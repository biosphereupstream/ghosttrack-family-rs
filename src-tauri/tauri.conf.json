{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostTrack Family",
  "version": "1.0.0",
  "identifier": "com.ghosttrack.family",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GhostTrack Family Locator",
        "width": 440,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
